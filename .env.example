# ============================================================
# BlogKit 环境变量模板
# 用法：cp .env.example .env → 修改【必改】→ docker compose up -d --build
#
# Docker 部署：数据库/Redis 主机、DB 连接串、生产环境自动配置，无需手写
# 本地开发：后端默认连 localhost:5432 / localhost:6379，profile=dev
# 图床等：后台「系统设置 → 上传设置」配置，不写在本文件
# ============================================================

# ---------- 运行环境 ----------
# dev = 本地开发；prod = 生产（Docker Compose 未设置时默认 prod）
BLOG_ENV=prod

# ---------- 访问 ----------
# 浏览器访问端口（http://服务器IP:此端口）
FRONTEND_PORT=3256
# 后台路径（不要尾斜杠；改后需重新构建）
BLOG_ADMIN_BASE_PATH=/admin
# 正式站点地址：有域名填 https://your.domain（不要尾斜杠）
# 留空 = 按浏览器访问的 IP/域名自动识别（前后台、邮件外链、SEO 共用）
BLOG_SITE_URL=

# ---------- 数据库（Compose 内置 PostgreSQL）----------
POSTGRES_DB=blog_system
# 【必改】现有卷改密码必须由管理员 ALTER ROLE，严禁删除数据卷
DB_PASSWORD=change-me

# ---------- 初始管理员 ----------
BLOG_ADMIN_USERNAME=admin
# 【必改】首次登录后请立即修改
BLOG_ADMIN_PASSWORD=change-me
BLOG_ADMIN_DISPLAY_NAME=站点管理员

# ---------- 安全密钥（四套禁止互相复用）【必改】----------
# 生成：openssl rand -hex 32
# DOWNLOAD  仅后端：下载密封
# TOTP      仅后端：二步验证密封（可留空则回退 DOWNLOAD）
# API_PAYLOAD  前后端：接口混淆（会进浏览器）
# BACKUP    仅后端：备份加密，≥32 字符
BLOG_DOWNLOAD_SECRET_KEY=change-me-download-secret-random
BLOG_MUSIC_API_KEY=
BLOG_MUSIC_NETEASE_API_KEY=
BLOG_MUSIC_CHKSZ_API_KEY=
BLOG_TOTP_SECRET_KEY=change-me-totp-secret-random
BLOG_API_PAYLOAD_SECRET=change-me-payload-obfuscation-random
BLOG_BACKUP_ENCRYPTION_KEY=change-me-use-at-least-32-random-characters

# ---------- 可选集成（不用可全部留空）----------
WECHAT_MINI_PROGRAM_APP_ID=
WECHAT_MINI_PROGRAM_APP_SECRET=
BLOG_MUSIC_API_KEY=
BLOG_MUSIC_NETEASE_API_KEY=
# 心知天气 widget token：https://www.seniverse.com
SENIVERSE_WIDGET_TOKEN=

# ---------- Docker 镜像（国内加速，可改官方）----------
POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:17-alpine
REDIS_IMAGE=docker.m.daocloud.io/library/redis:7-alpine
JDK_BUILD_IMAGE=docker.m.daocloud.io/library/eclipse-temurin:17-jdk-alpine
JRE_RUNTIME_IMAGE=docker.m.daocloud.io/library/eclipse-temurin:17-jre-alpine
NODE_IMAGE=docker.m.daocloud.io/library/node:22-alpine

# ---------- 运维：现有生产安装先看 docs/ops/production-runbook.md ----------
# 不得删除旧卷来改密码；以管理员 ALTER ROLE 后更新独立账号。
DB_ADMIN_USERNAME=blog_admin
DB_ADMIN_PASSWORD=change-me-independent-admin
DB_USERNAME=blog_app
DB_MIGRATION_USERNAME=blog_migrator
DB_MIGRATION_PASSWORD=change-me-independent-migration
BLOG_BACKUP_DB_USERNAME=blog_backup
BLOG_BACKUP_DB_PASSWORD=change-me-independent-backup
REDIS_PASSWORD=change-me-independent-redis
# 已有安装必须替换为 docker inspect 查到的实际卷名；不要猜测、不要 down -v。
POSTGRES_VOLUME_NAME=blog_postgres-data
REDIS_VOLUME_NAME=blog_redis-data
UPLOADS_VOLUME_NAME=blog_uploads-data
BACKUPS_VOLUME_NAME=blog-backups-data
POSTGRES_CONTAINER_NAME=blog-postgres
REDIS_CONTAINER_NAME=blog-redis
BACKEND_CONTAINER_NAME=blog-backend
FRONTEND_CONTAINER_NAME=blog-frontend
FRONTEND_BIND_IP=127.0.0.1
POSTGRES_MEMORY_LIMIT=256m
REDIS_MEMORY_LIMIT=96m
BACKEND_MEMORY_LIMIT=512m
FRONTEND_MEMORY_LIMIT=256m
DB_POOL_MAX=4
BLOG_BACKUP_RETENTION_COUNT=7
BLOG_BACKUP_REPLICA_DIR=
# 只信任实际前端容器地址/精确Docker网段；不要直接列出所有RFC1918。
BLOG_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
