/* ===== 文章详情：可读字号 ===== */
.detail-page {
  padding: 20rpx 0 calc(32rpx + env(safe-area-inset-bottom));
  background: #f5f7fb;
}

.article-detail {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 0 28rpx;
}

.article-hero {
  overflow: hidden;
  background: #ffffff;
  border-radius: 18rpx;
}

.article-hero__cover {
  width: 100%;
  height: 360rpx;
  background: #dbeafe;
  display: block;
}

.article-hero__body {
  padding: 28rpx;
}

.article-hero__meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.article-hero__title {
  margin-top: 16rpx;
  color: #0f172a;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.3;
}

.article-hero__summary {
  margin-top: 12rpx;
  color: #64748b;
  font-size: 28rpx;
  line-height: 1.6;
}

.article-hero__metrics {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx 14rpx;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #eef2f7;
  color: #64748b;
  font-size: 26rpx;
}

.article-hero__dot {
  color: #cbd5e1;
}

.article-hero__metrics .metric {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
}

.article-actions {
  display: flex;
  gap: 14rpx;
  padding: 16rpx;
  background: #ffffff;
  border-radius: 18rpx;
}

.action-button {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  min-height: 80rpx;
  border-radius: 14rpx;
  background: #eff6ff;
  color: #2563eb;
  font-size: 28rpx;
  font-weight: 600;
}

.action-button--active {
  background: #2563eb;
  color: #ffffff;
}

.action-button--fav.action-button--active {
  background: #2563eb;
  color: #ffffff;
}

.article-content {
  padding: 32rpx 28rpx;
  color: #1e293b;
  font-size: 32rpx;
  line-height: 1.85;
  background: #ffffff;
  border-radius: 18rpx;
}

.article-content__md {
  display: block;
  margin-bottom: 14rpx;
  line-height: 1.8;
  word-break: break-word;
}

.article-content__image {
  display: block;
  width: 100%;
  margin: 20rpx 0;
  border-radius: 14rpx;
  overflow: hidden;
  background: #dbeafe;
}

.article-lock {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
  padding: 72rpx 28rpx;
  text-align: center;
}

.article-lock__icon {
  width: 64rpx;
  height: 64rpx;
}

.article-lock__title {
  font-size: 32rpx;
  color: #0f172a;
  font-weight: 600;
}

.article-lock__form {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  width: 100%;
  max-width: 480rpx;
}

.article-lock__input {
  height: 84rpx;
  padding: 0 24rpx;
  border: 1rpx solid #dbeafe;
  border-radius: 14rpx;
  background: #f8fafc;
  font-size: 30rpx;
  text-align: center;
  color: #0f172a;
}

.article-lock__btn {
  min-height: 84rpx;
  border-radius: 14rpx;
  background: #2563eb;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
}

.bd-gallery {
  margin: 20rpx 0;
}

.bd-gallery--grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
}

.bd-gallery--grid .bd-gallery__cell {
  height: 220rpx;
}

.bd-gallery--single .bd-gallery__cell {
  width: 72%;
  max-height: 560rpx;
}

.bd-gallery--single .bd-gallery__img {
  height: auto;
}

.bd-gallery__cell {
  position: relative;
  width: 100%;
  border-radius: 12rpx;
  background: #dbeafe;
  overflow: hidden;
}

.bd-gallery__img {
  width: 100%;
  height: 100%;
  display: block;
}

.bd-gallery__more {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(15, 23, 42, 0.52);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
}

.comments {
  padding: 12rpx 28rpx 28rpx;
  background: #ffffff;
  border-radius: 18rpx;
}

.comments__header {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.comments__header .section-title {
  margin: 18rpx 0 14rpx;
}

.composer {
  padding: 18rpx;
  border-radius: 14rpx;
  background: #f8fafc;
  border: 1rpx solid #eef2f7;
}

.composer__input {
  width: 100%;
  min-height: 120rpx;
  padding: 18rpx;
  border-radius: 12rpx;
  background: #ffffff;
  color: #0f172a;
  font-size: 30rpx;
  line-height: 1.55;
}

.composer__bar {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 14rpx;
}

.composer__button {
  min-width: 200rpx;
}

.comments__empty {
  padding: 32rpx 0;
  color: #94a3b8;
  font-size: 28rpx;
  text-align: center;
}

.comment {
  padding: 24rpx 0;
  border-top: 1rpx solid #eef2f7;
}

.comment__main {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.comment__author {
  color: #0f172a;
  font-size: 28rpx;
  font-weight: 600;
}

.comment__time {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #94a3b8;
  font-size: 24rpx;
}

.comment__content {
  margin-top: 10rpx;
  color: #334155;
  font-size: 30rpx;
  line-height: 1.6;
}

.comment__actions {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin-top: 12rpx;
  color: #2563eb;
  font-size: 26rpx;
  font-weight: 600;
}

.comment__replies {
  margin-top: 14rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: #f8fafc;
}

.comment__reply {
  margin-bottom: 12rpx;
}

.comment__reply:last-child {
  margin-bottom: 0;
}

.comment__reply-author {
  color: #0f172a;
  font-weight: 600;
}

.comment__region {
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: #eff6ff;
  color: #2563eb;
  font-size: 20rpx;
}

.comment__reply-line {
  color: #334155;
  font-size: 28rpx;
  line-height: 1.55;
  word-break: break-word;
}

.comment__reply-meta {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 8rpx;
}

.comment__reply-btn {
  color: #2563eb;
  font-size: 24rpx;
  font-weight: 600;
}

.reply-composer {
  margin-top: 14rpx;
  padding: 16rpx;
  border-radius: 14rpx;
  background: #ffffff;
  border: 1rpx solid #eef2f7;
}

.reply-composer__input {
  width: 100%;
  min-height: 88rpx;
  padding: 14rpx;
  border-radius: 12rpx;
  background: #f8fafc;
  color: #0f172a;
  font-size: 28rpx;
  line-height: 1.5;
}

.reply-composer__bar {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  margin-top: 14rpx;
}

.reply-composer__cancel,
.reply-composer__submit {
  min-width: 140rpx;
  font-size: 28rpx;
}

.related {
  padding: 0;
}

.related-card {
  padding: 24rpx 26rpx;
  margin-bottom: 14rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.related-card__title {
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
}

.related-card__meta {
  margin-top: 10rpx;
  color: #94a3b8;
  font-size: 24rpx;
}

.bd-card {
  margin: 20rpx 0;
  padding: 24rpx;
  border: 1rpx solid #eef2f7;
  border-radius: 16rpx;
  background: #f8fafc;
}

.bd-card__head {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.bd-card__badge {
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  background: #2563eb;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
}

.bd-card__title {
  flex: 1;
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 600;
}

.bd-card__gate {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #eff6ff;
  color: #2563eb;
  font-size: 20rpx;
}

.bd-card__desc {
  margin-top: 12rpx;
  color: #64748b;
  font-size: 26rpx;
  line-height: 1.55;
}

.bd-card__item {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
  padding: 18rpx;
  border: 1rpx solid #eef2f7;
  border-radius: 14rpx;
  background: #ffffff;
}

.bd-card__item-main {
  flex: 1;
  min-width: 0;
}

.bd-card__item-name {
  display: block;
  color: #0f172a;
  font-size: 28rpx;
  font-weight: 600;
}

.bd-card__item-sub {
  display: block;
  margin-top: 6rpx;
  color: #94a3b8;
  font-size: 22rpx;
}

.bd-card__item-go {
  color: #2563eb;
  font-size: 26rpx;
  font-weight: 600;
}

.bd-locked {
  margin-top: 14rpx;
  padding: 28rpx 18rpx;
  border-radius: 14rpx;
  background: #eff6ff;
  color: #2563eb;
  font-size: 28rpx;
  text-align: center;
}

.bd-locked--secret {
  margin: 20rpx 0;
  border: 1rpx dashed #bfdbfe;
  background: #f8fafc;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.bd-button-wrap {
  margin: 20rpx 0;
}

.bd-link-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 40rpx;
  height: 84rpx;
  border-radius: 14rpx;
  background: #2563eb;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
}

.bd-secret {
  margin: 8rpx 0;
}
