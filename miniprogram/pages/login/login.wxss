/* ===== 登录 / 注册 ===== */
.login-page {
  display: flex;
  align-items: flex-start;
  min-height: 100vh;
  padding: 48rpx 28rpx;
  background: #f5f7fb;
}

.login-card {
  width: 100%;
  padding: 48rpx 32rpx 36rpx;
  background: #ffffff;
  border-radius: 18rpx;
}

.login-card__eyebrow {
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  text-align: center;
}

.login-card__title {
  margin-top: 14rpx;
  color: #0f172a;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.25;
  text-align: center;
}

.login-card__subtitle {
  margin-top: 12rpx;
  color: #64748b;
  font-size: 28rpx;
  line-height: 1.55;
  text-align: center;
}

.wechat-button {
  width: 100%;
  min-height: 92rpx;
  margin-top: 32rpx;
  border-radius: 14rpx;
  background: #07c160;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
}

.login-divider {
  display: flex;
  align-items: center;
  margin: 28rpx 0 24rpx;
  color: #94a3b8;
  font-size: 24rpx;
}

.login-divider view {
  flex: 1;
  height: 1rpx;
  background: #e2e8f0;
}

.login-divider text {
  padding: 0 18rpx;
}

.mode-switch {
  display: flex;
  gap: 8rpx;
  margin-bottom: 24rpx;
  padding: 6rpx;
  border-radius: 14rpx;
  background: #f1f5f9;
}

.mode-switch__item {
  flex: 1;
  min-height: 72rpx;
  border-radius: 12rpx;
  color: #64748b;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 72rpx;
  text-align: center;
}

.mode-switch__item--active {
  background: #ffffff;
  color: #2563eb;
  font-weight: 700;
}

.mode-switch__item--disabled {
  opacity: 0.38;
}

.field {
  margin-top: 18rpx;
}

.field__label {
  margin-bottom: 10rpx;
  color: #475569;
  font-size: 26rpx;
  font-weight: 600;
}

.field__input {
  min-height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  background: #f8fafc;
  color: #0f172a;
  font-size: 30rpx;
}

.submit-button {
  width: 100%;
  margin-top: 32rpx;
}

.login-card__notice {
  margin-top: 16rpx;
  color: #dc2626;
  font-size: 26rpx;
  text-align: center;
}

.sso-card {
  text-align: left;
}

.sso-status {
  margin-top: 32rpx;
  padding: 26rpx;
  border: 1rpx solid #eef2f7;
  border-radius: 14rpx;
  background: #f8fafc;
}

.sso-status--done {
  border-color: #bbf7d0;
  background: #f0fdf4;
}

.sso-status__title {
  color: #0f172a;
  font-size: 32rpx;
  font-weight: 700;
}

.sso-status__text {
  margin-top: 10rpx;
  color: #64748b;
  font-size: 28rpx;
  line-height: 1.55;
}

.sso-tip {
  margin-top: 18rpx;
  color: #94a3b8;
  font-size: 26rpx;
  line-height: 1.55;
  text-align: center;
}
